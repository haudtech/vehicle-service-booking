@authHost = http://localhost:5158
@bookingHost = http://localhost:5280
// Update this runId for a new test run. Keep it stable while running all requests in sequence. 
@runId = 20260719_01
@email = haud.fin@gmail.com
@phoneNumber = 
@accountName = workflow11_{{runId}}
@password = Test1234!
@appointmentDate = 2026-07-21
@dealershipId = 11111111-1111-1111-1111-000000000001
@customerId = 11111111-1111-1111-1111-010000000003
@vehicleId = 11111111-1111-1111-1111-020000000003
@serviceTypeId = 11111111-1111-1111-1111-030000000001
@currencyId = 00000000-0000-0000-0004-000000000001
@technicianId = 11111111-1111-1111-1111-040000000001
@serviceBayId = 11111111-1111-1111-1111-050000000001
@estimatedStartTimeSlotId = 00000000-0000-0000-0000-000000000007
@estimatedEndTimeSlotId = 00000000-0000-0000-0000-000000000008
@idempotencyKey = appt11-{{runId}}
@orderIdempotencyKey = order14-{{runId}}
@orderCode = ORD-{{runId}}
// challengeChannel: otp_first | email_otp | authenticator_app
@bootstrapChallengeChannel = email_otp
@authenticatorChallengeChannel = authenticator_app
@emailLoginVerificationCode = 024963
@authenticatorSetupCode = 137493
@authenticatorLoginCode = 900514

###
# End-to-end workflow:
# signup -> verify-email -> bootstrap login (email OTP) -> enroll authenticator app -> login (authenticator OTP) -> me -> availability -> appointments -> orders -> refresh -> logout
# If your Booking API runs on port 5290, change @bookingHost above.
# Keep @runId stable while running all requests in sequence. Change it for a new test run.

### 1) Sign up (returns Accepted + verification link)
# @name signup
POST {{authHost}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "{{email}}",
  "phoneNumber": "{{phoneNumber}}",
  "accountName": "{{accountName}}",
  "password": "{{password}}",
  "displayName": "HTTP Workflow User"
}

###
@verificationLink = {{signup.response.body.$.verificationLink}}
# Optional manual override:
# @verificationLink = {{authHost}}/api/v1/auth/verify-email?email={{email}}&token=PASTE_EMAIL_VERIFICATION_TOKEN

### 2) Verify email by callback link from signup response
# @name verifyEmailCallback
GET {{verificationLink}}
Accept: application/json

### 3) Optional fallback: verify email by POST using token from notification
# @name verifyEmailPost
POST {{authHost}}/api/v1/auth/verify-email
Content-Type: application/json

{
  "email": "{{email}}",
  "token": "PASTE_EMAIL_VERIFICATION_TOKEN_FROM_NOTIFICATION"
}

### 4) Bootstrap login by account name (email OTP challenge; does not return JWT)
# @name bootstrapLoginChallenge
POST {{authHost}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "{{accountName}}",
  "email": "{{email}}",
  "challengeChannel": "{{bootstrapChallengeChannel}}",
  "password": "{{password}}"
}

###
@bootstrapChallengeId = {{bootstrapLoginChallenge.response.body.$.challengeId}}

### 5) Complete bootstrap login challenge with email OTP (returns tokens)
# @name bootstrapLoginVerifyCode
POST {{authHost}}/api/v1/auth/login/verify-code
Content-Type: application/json

{
  "email": "{{email}}",
  "challengeId": "{{bootstrapChallengeId}}",
  "code": "{{emailLoginVerificationCode}}"
}

###
@bootstrapAccessToken = {{bootstrapLoginVerifyCode.response.body.$.accessToken}}
@bootstrapRefreshToken = {{bootstrapLoginVerifyCode.response.body.$.refreshToken}}

### 6) Start authenticator setup for current user (requires bootstrap access token)
# @name startAuthenticatorSetup
POST {{authHost}}/api/v1/auth/mfa/authenticator/setup/start
Content-Type: application/json
Authorization: Bearer {{bootstrapAccessToken}}
Accept: application/json

{}

###
@otpauthUri = {{startAuthenticatorSetup.response.body.$.otpauthUri}}
@qrPayload = {{startAuthenticatorSetup.response.body.$.qrPayload}}
@qrImageUrl = {{startAuthenticatorSetup.response.body.$.qrImageUrl}}

### 6.1) Optional: fetch QR image directly from Auth API (PNG)
# @name getAuthenticatorSetupQrImage
GET {{qrImageUrl}}
Authorization: Bearer {{bootstrapAccessToken}}
Accept: image/png

### 7) Verify authenticator setup using current authenticator app TOTP
# @name verifyAuthenticatorSetup
POST {{authHost}}/api/v1/auth/mfa/authenticator/setup/verify
Content-Type: application/json
Authorization: Bearer {{bootstrapAccessToken}}

{
  "code": "{{authenticatorSetupCode}}"
}

### 8) Login with authenticator channel (starts challenge; does not return JWT)
# @name authenticatorLoginChallenge
POST {{authHost}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "{{accountName}}",
  "email": "{{email}}",
  "challengeChannel": "{{authenticatorChallengeChannel}}",
  "password": "{{password}}"
}

###
@authenticatorChallengeId = {{authenticatorLoginChallenge.response.body.$.challengeId}}

### 9) Complete authenticator login challenge with app TOTP (returns tokens)
# @name authenticatorLoginVerifyCode
POST {{authHost}}/api/v1/auth/login/verify-code
Content-Type: application/json

{
  "email": "{{email}}",
  "challengeId": "{{authenticatorChallengeId}}",
  "code": "{{authenticatorLoginCode}}"
}

###
@loginAccessToken = {{authenticatorLoginVerifyCode.response.body.$.accessToken}}
@loginRefreshToken = {{authenticatorLoginVerifyCode.response.body.$.refreshToken}}

### 10) Verify current user claims
# @name me
GET {{authHost}}/api/v1/me
Authorization: Bearer {{loginAccessToken}}
Accept: application/json

### 11) Query availability from Booking service (JWT/JWKS path)
# @name availability
GET {{bookingHost}}/api/v1/availability?dealershipId={{dealershipId}}&serviceTypeId={{serviceTypeId}}&date={{appointmentDate}}
Authorization: Bearer {{loginAccessToken}}
Accept: application/json

###
@availableTechnicianId = {{availability.response.body.$[0].technicianId}}
@availableServiceBayId = {{availability.response.body.$[0].serviceBayId}}
@availableStartTimeSlotId = {{availability.response.body.$[0].timeSlotId}}
@availableEndTimeSlotId = {{availability.response.body.$[0].endTimeSlotId}}

### 12) Create appointment (auth-integrated)
# @name createAppointment
POST {{bookingHost}}/api/v1/appointments
Content-Type: application/json
Authorization: Bearer {{loginAccessToken}}
Idempotency-Key: {{idempotencyKey}}

{
  "dealershipId": "{{dealershipId}}",
  "vehicleId": "{{vehicleId}}",
  "appointmentDate": "{{appointmentDate}}",
  "serviceTypeId": "{{serviceTypeId}}",
  "technicianId": "{{availableTechnicianId}}",
  "serviceBayId": "{{availableServiceBayId}}",
  "estimatedStartTimeSlotId": "{{availableStartTimeSlotId}}",
  "estimatedEndTimeSlotId": "{{availableEndTimeSlotId}}"
}

###
@appointmentId = {{createAppointment.response.body.$.appointmentId}}

### 13) Read appointment by id (optional verification)
# @name getAppointmentById
GET {{bookingHost}}/api/v1/appointments/{{appointmentId}}
Authorization: Bearer {{loginAccessToken}}
Accept: application/json

### 14) Create order from appointment (auth-integrated)
# @name createOrder
POST {{bookingHost}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{loginAccessToken}}
Idempotency-Key: {{orderIdempotencyKey}}

{
  "orderCode": "{{orderCode}}",
  "currencyId": "{{currencyId}}",
  "serviceTypeItems": [
    {
      "serviceTypeId": "{{serviceTypeId}}",
      "quantity": 1
    }
  ],
  "appointmentIds": [
    "{{appointmentId}}"
  ]
}

###
@orderId = {{createOrder.response.body.$.orderId}}
@orderTotalAmount = {{createOrder.response.body.$.totalAmount}}
@orderLocation = {{createOrder.response.headers.Location}}

### 15) Read order by URI from Location header returned by create order
# Booking API currently returns a relative Location path, so prepend {{bookingHost}}.
# @name getOrderByLocation
GET {{bookingHost}}{{orderLocation}}
Authorization: Bearer {{loginAccessToken}}
Accept: application/json

### 16) Replay create order with same idempotency key (should return stored response)
# @name replayCreateOrder
POST {{bookingHost}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{loginAccessToken}}
Idempotency-Key: {{orderIdempotencyKey}}

{
  "orderCode": "{{orderCode}}",
  "currencyId": "{{currencyId}}",
  "serviceTypeItems": [
    {
      "serviceTypeId": "{{serviceTypeId}}",
      "quantity": 1
    }
  ],
  "appointmentIds": [
    "{{appointmentId}}"
  ]
}

###
@replayedOrderId = {{replayCreateOrder.response.body.$.orderId}}
@replayedOrderTotalAmount = {{replayCreateOrder.response.body.$.totalAmount}}

### 17) Refresh token (optional lifecycle step)
# @name refresh
POST {{authHost}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginRefreshToken}}"
}

###
@newAccessToken = {{refresh.response.body.$.accessToken}}
@newRefreshToken = {{refresh.response.body.$.refreshToken}}

### 18) Logout / revoke refresh token (optional lifecycle step)
# @name logout
POST {{authHost}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{newRefreshToken}}"
}

### 19) JWKS verification endpoint (optional)
# @name jwks
GET {{authHost}}/api/v1/.well-known/jwks.json
Accept: application/json
