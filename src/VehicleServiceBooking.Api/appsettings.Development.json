{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vehicle_service_booking;Username=haudo;Password=<password>;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Query": "Information"
    }
  },
  "AuthJwt": {
    "Issuer": "https://auth.vehicle-service-booking.local",
    "Audience": "vehicle-booking-api",
    "JwksUrl": "http://localhost:5158/api/v1/.well-known/jwks.json",
    "JwksCacheMinutes": 15,
    "EnableDiagnostics": true
  },
  "AuthUserProfile": {
    "Scheme": "http",
    "Host": "localhost",
    "Port": 5158,
    "CoreProfilePathTemplate": "/api/v1/internal/users/{authUserId}/core-profile",
    "TimeoutSeconds": 5
  },
  "Observability": {
    "Serilog": {
      "MinimumLevel": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Information"
      },
      "EnableConsole": true,
      "EnableFile": true,
      "FilePath": "logs/app-.txt",
      "RollingInterval": "Day"
    },
    "OpenTelemetry": {
      "Tracing": {
        "UseAspNetCoreInstrumentation": true,
        "UseEntityFrameworkCoreInstrumentation": true,
        "Exporter": "Console"
      }
    },
    "EntityFramework": {
      "EnableDetailedErrors": true,
      "EnableSensitiveDataLogging": true
    }
  },
  "Scheduling": {
    "SlotLengthMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "ExposedHeaders": [],
    "MaxAge": 300,
    "AllowCredentials": true,
    "PolicyName": "DevelopmentCorsPolicy"
  },
  "StaticDataCache": {
    "Enabled": true,
    "CacheTimeSlots": true,
    "CacheAppointmentStatuses": true,
    "CacheServiceStatuses": true,
    "TimeSlotsTtlMinutes": 30,
    "AppointmentStatusesTtlMinutes": 30,
    "ServiceStatusesTtlMinutes": 30
  },
  "Idempotency": {
    "Enabled": true,
    "RequireHeader": false,
    "KeyMaxLength": 100,
    "EntryTtlHours": 24
  }
  ,
  "PaymentWebhookSecurity": {
    "Enabled": true,
    "RequireSignature": true,
    "SharedSecret": "change-me-in-development"
  }
}
