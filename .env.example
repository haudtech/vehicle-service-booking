# Vehicle Service Booking API - Environment Configuration (.env.example)
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Customize the values for your local environment
# 3. This file (.env.example) is committed to Git, .env is not

# ===================================================================
# Environment
# ===================================================================
ASPNETCORE_ENVIRONMENT=Development

# ===================================================================
# Service-specific Database Connection Strings
# ===================================================================
# API service database
# API__CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=vehicle_service_booking;Username=your-user;Password=your-password;

# Auth service database
# AUTH__CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=vehicle_service_booking_auth_dev;Username=your-user;Password=your-password;

# ===================================================================
# Logging
# ===================================================================
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT=Warning

# ===================================================================
# CORS Configuration
# ===================================================================
# Allowed origins for development frontend
CORS__ALLOWEDORIGINS__0=http://localhost:3000
CORS__ALLOWEDORIGINS__1=http://localhost:5173

# Allowed HTTP methods
CORS__ALLOWEDMETHODS__0=GET
CORS__ALLOWEDMETHODS__1=POST
CORS__ALLOWEDMETHODS__2=PUT
CORS__ALLOWEDMETHODS__3=DELETE
CORS__ALLOWEDMETHODS__4=PATCH
CORS__ALLOWEDMETHODS__5=OPTIONS

# Allowed headers
CORS__ALLOWEDHEADERS__0=*

# Preflight cache duration (seconds)
CORS__MAXAGE=300

# Allow credentials
CORS__ALLOWCREDENTIALS=true

# Policy name
CORS__POLICYNAME=DevelopmentCorsPolicy

# ===================================================================
# Scheduling
# ===================================================================
SCHEDULING__SLOTLENGTHMINUTES=30

# ===================================================================
# Payment Webhook Security
# ===================================================================
# PAYMENTWEBHOOKSECURITY__ENABLED=true
# PAYMENTWEBHOOKSECURITY__REQUIRESIGNATURE=true
# PAYMENTWEBHOOKSECURITY__SHAREDSECRET=replace-with-strong-random-secret

# ===================================================================
# Notes
# ===================================================================
# Auth service Google OAuth (optional; required when Authentication:Google:Enabled=true)
# AUTHENTICATION__GOOGLE__CLIENTID=your-google-client-id.apps.googleusercontent.com
# AUTHENTICATION__GOOGLE__CLIENTSECRET=your-google-client-secret

# Auth service async notification publishing (optional)
# NOTIFICATION__ENABLED=true
# NOTIFICATION__QUEUECONNECTIONSTRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# NOTIFICATION__QUEUENAME=user-notification-events
# NOTIFICATION__SOURCE=auth-service
# EMAILSENDER__PROVIDER=Google
# EMAILSENDER__FROMADDRESS=noreply@yourdomain.com
# EMAILSENDER__FROMNAME=Vehicle Service Booking
# EMAILSENDER__SENDGRIDENDPOINT=https://api.sendgrid.com/v3/mail/send
# EMAILSENDER__SENDGRIDAPIKEY=SG.your-real-key

# Observability exporter (Console | ApplicationInsights | AzureMonitor)
# OBSERVABILITY__OPENTELEMETRY__TRACING__EXPORTER=Console
# OBSERVABILITY__OPENTELEMETRY__TRACING__AZUREMONITOR__CONNECTIONSTRING=

# - Variable naming: Use __ for nested JSON properties
#   Example: CORS__ALLOWEDORIGINS__0 = Cors:AllowedOrigins[0]
#
# - This file is loaded by Program.cs using DotNetEnv
#
# - Environment variables in .env override appsettings files
#   Precedence: .env > appsettings.{Env}.json > appsettings.json


